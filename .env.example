# MediFlow environment reference.
#
# The Worker reads backend/.dev.vars during local development.
# Copy backend/.dev.vars.example to backend/.dev.vars and fill in real values.
# Never commit the filled file.
#
# AUTH_MODE: "session" (default, secure) or "demo" (explicit synthetic demo).
# Demo mode is refused when ENVIRONMENT=production.
AUTH_MODE=session
ENVIRONMENT=development

# Comma-separated exact origins. Empty means same-origin only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Turso / libSQL
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token

# Gemini (optional). Without it, deterministic text fallbacks are used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# One-time demo reset credential (optional). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_RESET_TOKEN=

# Password used once by `npm run db:seed` to create demo users.
# If omitted, the seed prints a generated password once. It is never stored in plaintext.
DEMO_SEED_PASSWORD=

# Optional FHIR R4 endpoint. Must be https except for localhost.
FHIR_BASE_URL=
FHIR_ACCESS_TOKEN=

# Optional rate-limit overrides.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
